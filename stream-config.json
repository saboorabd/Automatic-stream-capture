{
  "project": "stream-capture",
  "version": "1.1.0",
  "description": "Single source of truth for capture, server, hosting and speed settings. Edit values here; keep the names as they are.",

  "capture": {
    "page_url": "https://www.zee5.com/live-tv/zee-thirai-hd/0-9-224",
    "stream_pattern": "\\.m3u8(?:$|[?#])",
    "play_selectors": ["button.play", "video", "[aria-label='Play']"],
    "capture_timeout_s": 60,
    "refresh_interval_s": 30,
    "headless": false,
    "proxy_url": ""
  },

  "sources": [
    { "order": 1, "id": "video_link_extractor", "name": "Video Link Extractor Pro", "kind": "extension", "repo": "https://github.com/jrcramos/video_link_extractor", "required": false },
    { "order": 2, "id": "stream_detector", "name": "The Stream Detector", "kind": "extension", "store_id": "iakkmkmhhckcmoiibcfjnooibphlobak", "required": false },
    { "order": 3, "id": "m3u8_sniffer", "name": "M3U8 Sniffer", "kind": "extension", "store_id": "akkncdpkjlfanomlnpmmolafofpnpjgn", "required": false },
    { "order": 4, "id": "network", "name": "Network sniffing", "kind": "builtin", "required": true },
    { "order": 5, "id": "page_source", "name": "Page source scan", "kind": "builtin", "required": true }
  ],

  "server": {
    "extensions_root": "/opt/extensions",
    "port_env": "PORT",
    "default_port": 8000,
    "proxy_cache_control": "no-cache",
    "playlist_max_bytes": 2097152
  },

  "render": {
    "plan": "starter",
    "runtime": "docker",
    "health_path": "/api/status",
    "env": {
      "EXTENSIONS_ROOT": "/opt/extensions",
      "ALLOWED_ORIGIN": "https://saboorabd.github.io",
      "PROXY_URL": ""
    }
  },

  "keepalive": {
    "provider": "cron-job.org",
    "url": "https://automatic-stream-capture.onrender.com/api/status",
    "interval_minutes": 5
  },

  "frontend": {
    "pages_path": "/docs",
    "api_base_when_on_pages": "https://automatic-stream-capture.onrender.com",
    "last_stream_max_age_hours": 6,
    "keepalive_ping_minutes": 4,
    "status_poll_seconds": 2
  }
}
